# =====================================================================
# BUSY Bar + Google Home Laundry Bridge Configuration
# =====================================================================

# Local IP Address of your BUSY Bar (found in BUSY Bar Settings -> Wi-Fi or router)
BUSY_BAR_IP=192.168.1.100

# Optional / Required for Wi-Fi: HTTP Access Password / Token set on your BUSY Bar
# Check http://<BUSY_BAR_IP> in your browser under Network / Settings -> HTTP Access
BUSY_BAR_TOKEN=

# Sinric Pro Credentials (from https://portal.sinric.pro)
SINRIC_APP_KEY=your_sinric_app_key_here
SINRIC_APP_SECRET=your_sinric_app_secret_here

# Sinric Pro Device IDs:
# OPTION 1: Single unified switch (ideal for one shared "Laundry done" alert)
LAUNDRY_DEVICE_ID=your_laundry_switch_device_id_here

# OPTION 2: Separate washer and dryer switches (both will trigger the laundry alert)
# WASHER_DEVICE_ID=your_washer_switch_device_id_here
# DRYER_DEVICE_ID=your_dryer_switch_device_id_here

# OPTION 3: Arbitrary named Sinric Pro devices
# Any DEVICE_<NAME>_ID will be connected and kept online/active in Sinric Pro & Google Home.
# Optionally set DEVICE_<NAME>_TEXT to display a message on the BUSY Bar when turned ON
# (if DEVICE_<NAME>_TEXT is omitted, the switch is kept online without affecting the BUSY Bar).
# DEVICE_DISHWASHER_ID=your_dishwasher_device_id_here
# DEVICE_DISHWASHER_TEXT=Dishwasher done
# DEVICE_OFFICE_LAMP_ID=your_office_lamp_device_id_here

# How many seconds to keep the alert on the BUSY Bar screen before auto-clearing
# Default: 1800 seconds (30 minutes). Set to 0 to disable auto-clear.
ALERT_TIMEOUT_SECONDS=1800

# Message text to show on front matrix
LAUNDRY_ALERT_TEXT=Laundry done

# Sound to play when notification triggers:
# Stock sounds: event, reminder, volume (or leave blank for silent)
ALERT_SOUND=event
